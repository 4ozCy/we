{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.js" },
    { "src": "^/tf$", "dest": "/index.js" },
    { "src": "^/aimbot$", "dest": "/index.js" },
    { "src": "^/tpwalk$", "dest": "/index.js" },
    { "src": "^/esp$", "dest": "/index.js" },
    { "src": "^/fps$", "dest": "/index.js" },
    { "src": "^/tp$", "dest": "/index.js" }
  ]
}
