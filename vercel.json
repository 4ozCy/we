{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
  "routes": [
    { "src": "/[^/]+\\.html", "use": "@vercel/static" },
    { "src": "/[^/]+\\.(png|jpg|jpeg|gif|webp|svg|mp4|mp3)", "use": "@vercel/static" }
  ]
    }
  ],
  "routes": [
    { "src": "/.*", "dest": "/index.js" }
  ]
}
